# Alertmanager Configuration - Production with Email
# Simplified for non-enterprise use

global:
  smtp_smarthost: '${SMTP_SMARTHOST}'
  smtp_from: '${SMTP_FROM}'
  smtp_auth_username: '${SMTP_AUTH_USERNAME}'
  smtp_auth_password: '${SMTP_AUTH_PASSWORD}'
  smtp_require_tls: ${SMTP_REQUIRE_TLS}

route:
  group_by: ['alertname', 'service']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'email-alerts'
  routes:
    - match:
        severity: critical
      receiver: 'email-alerts'
      group_wait: 10s
      repeat_interval: 1h

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'service']
  
  - source_match:
      alertname: 'CircuitBreakerOpen'
    target_match_re:
      alertname: '(SlowUploadSpeed|HighErrorRate)'
    equal: ['service']

receivers:
  - name: 'email-alerts'
    email_configs:
      - to: '${EMAIL_ADMIN}'
        send_resolved: true
        headers:
          Subject: '{{ if eq .Status "firing" }}Alert{{ else }}Resolved{{ end }} - Cloud Monitor: {{ .CommonLabels.alertname }}'
        html: |
          <!DOCTYPE html>
          <html>
          <head>
            <style>
              body { font-family: sans-serif; padding: 20px; background: #f5f5f5; }
              .container { max-width: 600px; margin: 0 auto; background: white; border-radius: 8px; overflow: hidden; }
              .header { padding: 20px; color: white; }
              .header.firing { background: #dc3545; }
              .header.resolved { background: #28a745; }
              .content { padding: 20px; }
              .alert-box { background: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin: 10px 0; }
              .alert-box.critical { border-color: #dc3545; }
              .alert-box.warning { border-color: #ffc107; }
              .footer { padding: 15px; background: #f8f9fa; font-size: 12px; color: #666; text-align: center; }
            </style>
          </head>
          <body>
            <div class="container">
              <div class="header {{ if eq .Status "firing" }}firing{{ else }}resolved{{ end }}">
                <h1>{{ if eq .Status "firing" }}Alert Firing{{ else }}Alert Resolved{{ end }}</h1>
              </div>
              <div class="content">
                {{ range .Alerts }}
                <div class="alert-box {{ .Labels.severity }}">
                  <h3>{{ .Labels.alertname }}</h3>
                  <p><b>Service:</b> {{ .Labels.service }}</p>
                  <p><b>Instance:</b> {{ .Labels.exported_instance }}</p>
                  <p><b>Summary:</b> {{ .Annotations.summary }}</p>
                  <p><b>Description:</b> {{ .Annotations.description }}</p>
                  <p><b>Time:</b> {{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}</p>
                </div>
                {{ end }}
              </div>
              <div class="footer">Cloud Performance Monitor</div>
            </div>
          </body>
          </html>
    
    webhook_configs:
      - url: 'http://webhook-logger:8080/webhook'
        send_resolved: true
